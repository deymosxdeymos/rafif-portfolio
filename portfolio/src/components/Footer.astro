---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="wrap flex flex-col gap-3 border-t border-line py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
  <p>© {year} {site.name}. Designed and built with Astro.</p>
  <ul class="-my-3 flex gap-5">
    {
      site.socials.map((s) => (
        <li>
          <a class="inline-block py-3 transition-colors hover:text-ink" href={s.href} target="_blank" rel="noreferrer">
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>
