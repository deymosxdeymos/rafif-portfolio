---
import Base from "../../layouts/Base.astro";
import Phone from "../../components/Phone.astro";
import Sparkle from "../../components/Sparkle.astro";
import Cursor from "../../components/Cursor.astro";
import { site } from "../../data/site";

import coverHome from "../../assets/teachtech/cover-home.png";
import home from "../../assets/teachtech/home.png";
import topic from "../../assets/teachtech/topic.png";
import chat from "../../assets/teachtech/chat.png";
import history from "../../assets/teachtech/history.png";
import login from "../../assets/teachtech/login.png";
import register from "../../assets/teachtech/register.png";
import forgot from "../../assets/teachtech/forgot.png";
import otp from "../../assets/teachtech/otp.png";

const facts = [
  { k: "Program", v: "Bangkit Academy 2024 · Company Capstone" },
  { k: "Partner", v: "Kaizen Room" },
  { k: "My role", v: "Mobile Development (Android)" },
  { k: "Stack", v: "Android MVVM · Go · GCP · SEA-LION" },
];

const challenges = [
  { t: "Time-consuming", d: "Teachers can't block out days for long, intensive training sessions on top of a full teaching load." },
  { t: "Generic", d: "Most programmes are one-size-fits-all and ignore what an individual teacher actually struggles with." },
  { t: "Inaccessible", d: "Good training is expensive and hard to reach, especially outside big cities." },
];

const data = [
  { n: "63%", src: "Ministry of Education and Culture, Indonesia", d: "of teachers feel they need more training integrating technology into their teaching." },
  { n: "65%", src: "RAND Corporation", d: "of educators say professional development doesn't prepare them for student behaviour issues." },
  { n: "74%", src: "EdTech Magazine", d: "of teachers want more training in using educational technology effectively." },
  { n: "50%", src: "The Learning Policy Institute", d: "of teachers feel unprepared to meet the needs of diverse learners." },
  { n: "40%", src: "NCES", d: "of teachers say their PD activities are aligned with their daily teaching needs." },
];

const flows = [
  {
    t: "Authentication",
    steps: ["Open app", "Already a user?", "Register → verify email (OTP)", "Log in", "Forgot password → reset"],
  },
  {
    t: "Send a chat",
    steps: ["Dashboard · Discover", "Pick a topic", "Enter a prompt", "Receive AI response", "Or open chat history"],
  },
  {
    t: "Profile",
    steps: ["Dashboard · Profile", "Change password: old + new", "Edit profile: photo, name, institution, birth date", "Save"],
  },
];
---

<Base brand={{ accent: "#b42318", accentSoft: "#fee4e2", pop: "#fdb022" }} title={`TeachTechAI case study | ${site.name}`} description="Case study: TeachTechAI, an Android app that helps teachers build soft skills with a fine-tuned LLM.">
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-[linear-gradient(180deg,#fde8e6_0%,#f6f5f1_75%)] pt-28 sm:pt-32">
    <div class="absolute -right-40 top-40 -z-10 size-[36rem] rounded-full bg-[#f04438]/25 blur-[120px]" aria-hidden="true"></div>
    <div class="wrap">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap gap-2">
          <span class="pill bg-card ring-1 ring-line">Mobile Dev</span>
          <span class="pill bg-card ring-1 ring-line">Android</span>
          <span class="pill bg-card ring-1 ring-line">AI</span>
          <span class="pill bg-[#b42318] text-white">C241-TA01</span>
        </div>
        <span class="font-display font-bold text-muted">/2024</span>
      </div>

      <h1 class="display mt-10 text-[clamp(3.5rem,13.5vw,12.5rem)] text-[#7a271a] [&>span]:inline-block" data-intro>
        <span>TeachTech</span><span class="text-[#f04438]">AI</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl" data-reveal="0.3">
        Shaping tomorrow's education with today's technology. An Android app where teachers pick
        a topic, get a short lesson, and practise with an AI assistant trained on Kaizen Room's
        teaching material.
      </p>
    </div>

    <!-- phone stage -->
    <div class="wrap relative mt-14 h-[38rem] sm:h-[47rem]" data-reveal="0.4">
      <div class="absolute left-1/2 top-0 w-[58%] max-w-[300px] -translate-x-1/2 sm:w-[300px]">
        <Phone src={coverHome} alt="TeachTechAI home: greeting, search, topic categories and popular topics" eager />
      </div>
      <div class="absolute left-1/2 top-16 hidden w-[240px] -translate-x-[150%] -rotate-[8deg] sm:block">
        <Phone src={topic} alt="Topic detail: Pendidikan Karakter, with prompt inspirations" />
      </div>
      <div class="absolute left-1/2 top-16 hidden w-[240px] translate-x-[50%] rotate-[8deg] sm:block">
        <Phone src={chat} alt="Chat with the TeachTechAI assistant" />
      </div>

      <span data-float="10" class="pill absolute left-[2%] top-[12%] bg-white px-4 py-2.5 text-sm text-[#b42318] shadow-xl ring-1 ring-[#fecdca] sm:left-[6%]">
        Hello! How can I assist you today?
      </span>
      <span data-float="8" class="pill absolute right-[2%] top-[34%] bg-lime px-4 py-2.5 text-sm font-semibold shadow-xl sm:right-[6%]">
        SEA-LION-7B-Instruct
      </span>
      <span data-float="12" class="pill absolute bottom-[26%] left-[4%] hidden bg-ink px-4 py-2.5 text-sm text-paper shadow-xl md:inline-flex">
        Kaizen Room × Bangkit
      </span>
      <Cursor label="Guru" tone="violet" class="absolute right-[16%] top-[64%] hidden md:flex" />
      <Sparkle class="absolute right-[18%] top-[4%] size-10 text-[#f04438]" />
      <Sparkle class="absolute right-[14%] top-[12%] size-4 text-[#f04438]/50" />
    </div>
  </section>

  <!-- FACTS -->
  <section class="wrap pb-20">
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl bg-line ring-1 ring-line md:grid-cols-4" data-stagger>
      {
        facts.map((f) => (
          <div class="bg-card p-5">
            <dt class="eyebrow">{f.k}</dt>
            <dd class="mt-2 font-medium">{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- PROBLEM -->
  <section class="bg-[#7a271a] py-24 text-white sm:py-32">
    <div class="wrap">
      <p class="eyebrow !text-[#fda29b]">01 · Background</p>
      <h2 class="h2 mt-4 max-w-4xl" data-reveal>Teaching changed faster than teacher training did.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85" data-reveal="0.1">
        Teachers now need more than subject knowledge. Communication, adaptability and empathy
        decide whether a class works. But the training on offer has three recurring problems.
      </p>
      <ol class="mt-14 grid gap-4 md:grid-cols-3" data-stagger>
        {
          challenges.map((c, i) => (
            <li class="rounded-3xl bg-white p-7 text-ink">
              <span class="font-display text-sm font-bold text-[#d92d20]">{String(i + 1).padStart(2, "0")}</span>
              <p class="mt-6 font-display text-2xl font-extrabold uppercase tracking-tight text-[#b42318]">{c.t}</p>
              <p class="mt-3 text-muted">{c.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- DATA -->
  <section class="wrap py-24 sm:py-32">
    <p class="eyebrow">02 · The numbers</p>
    <h2 class="h2 mt-4 max-w-3xl" data-reveal>Teachers are asking for it.</h2>
    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5" data-stagger>
      {
        data.map((s) => (
          <li class="flex flex-col rounded-3xl bg-card p-6 ring-1 ring-line">
            <p class="display text-6xl text-[#d92d20]">{s.n}</p>
            <p class="mt-4 text-sm text-ink">{s.d}</p>
            <p class="mt-auto pt-6 text-xs font-medium text-muted">{s.src}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- SOLUTION / SCREENS: MAIN -->
  <section class="border-t border-line bg-card py-24 sm:py-32">
    <div class="wrap">
      <p class="eyebrow">03 · The product</p>
      <h2 class="h2 mt-4 max-w-3xl" data-reveal>Short lessons, then practise with an AI.</h2>
      <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal="0.1">
        The app has three parts: authentication, the main Discover dashboard, and a profile area.
        Everything is in Bahasa Indonesia, written for teachers rather than techies.
      </p>

      <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        <figure>
          <Phone src={home} alt="Discover dashboard" />
          <figcaption class="mt-5">
            <p class="font-display text-lg font-extrabold tracking-tight">Discover</p>
            <p class="mt-1 text-sm text-muted">Greeting, search, topic categories (child psychology, counselling, science & tech), then popular and newest topics.</p>
          </figcaption>
        </figure>
        <figure>
          <Phone src={topic} alt="Topic detail page" />
          <figcaption class="mt-5">
            <p class="font-display text-lg font-extrabold tracking-tight">Topic</p>
            <p class="mt-1 text-sm text-muted">A short brief, then "Inspirasi Prompt" cards (discussion questions, case studies) so nobody stares at an empty box.</p>
          </figcaption>
        </figure>
        <figure>
          <Phone src={chat} alt="Chat with the assistant" />
          <figcaption class="mt-5">
            <p class="font-display text-lg font-extrabold tracking-tight">Chat</p>
            <p class="mt-1 text-sm text-muted">The TeachTechAI assistant answers in context of the topic. Responses can be copied, regenerated or flagged.</p>
          </figcaption>
        </figure>
        <figure>
          <Phone src={history} alt="Topic history drawer" />
          <figcaption class="mt-5">
            <p class="font-display text-lg font-extrabold tracking-tight">History</p>
            <p class="mt-1 text-sm text-muted">A side drawer groups past conversations by month, so teachers can pick a thread back up.</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- AUTH -->
  <section class="wrap py-24 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:items-center">
      <div data-reveal>
        <span class="pill bg-[#fee4e2] text-[#b42318]">Authentication</span>
        <h3 class="mt-5 font-display text-3xl font-extrabold tracking-tight">Get in, without a support call.</h3>
        <p class="mt-4 text-muted">
          Email or Google sign-in, sign-up with terms consent, password reset by email, and a
          6-digit OTP with a visible countdown and resend link. The register button stays disabled
          until the form is valid.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-5 sm:grid-cols-4" data-stagger>
        <Phone src={login} alt="Login screen" />
        <Phone src={register} alt="Register screen" />
        <Phone src={forgot} alt="Forgot password screen" />
        <Phone src={otp} alt="OTP verification screen" />
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section class="bg-ink py-24 text-paper sm:py-32">
    <div class="wrap">
      <p class="eyebrow !text-lime">04 · Under the hood</p>
      <h2 class="h2 mt-4 max-w-3xl" data-reveal>From a tap to a fine-tuned model, privately.</h2>
      <p class="mt-6 max-w-2xl text-lg text-paper/65" data-reveal="0.1">
        I built the Android client. It talks to a Go API on App Engine, which reaches the model
        and database inside a VPC through a Serverless VPC Connector. No resource has a public IP.
      </p>

      <div class="mt-14 grid gap-4 lg:grid-cols-[1fr_auto_1.2fr_auto_1.3fr] lg:items-stretch" data-stagger>
        <div class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
          <span class="pill bg-[#9b8afb] text-ink">Android app</span>
          <ol class="mt-6 space-y-2 font-medium">
            <li class="rounded-xl bg-[#bdb4fe]/15 px-4 py-3">View</li>
            <li class="rounded-xl bg-[#bdb4fe]/15 px-4 py-3">ViewModel</li>
            <li class="rounded-xl bg-[#bdb4fe]/15 px-4 py-3">Model</li>
          </ol>
          <p class="mt-4 text-sm text-paper/65">MVVM. My part of the team.</p>
        </div>

        <div class="grid place-items-center text-center text-xs text-paper/65">
          <span class="rotate-90 lg:rotate-0">REST ⇄<br />JSON</span>
        </div>

        <div class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
          <span class="pill bg-[#fb6514] text-ink">Go API · App Engine</span>
          <ol class="mt-6 space-y-2 font-medium">
            <li class="rounded-xl bg-[#fb6514]/15 px-4 py-3">Controller</li>
            <li class="rounded-xl bg-[#fb6514]/15 px-4 py-3">Service</li>
            <li class="rounded-xl bg-[#fb6514]/15 px-4 py-3">Repository</li>
          </ol>
          <div class="mt-4 grid grid-cols-2 gap-2 text-sm">
            <span class="rounded-xl bg-white/10 px-3 py-2">Cloud SQL<br /><span class="text-paper/65">PostgreSQL · chat history</span></span>
            <span class="rounded-xl bg-white/10 px-3 py-2">Cloud Storage<br /><span class="text-paper/65">profile photos</span></span>
          </div>
        </div>

        <div class="grid place-items-center text-center text-xs text-paper/65">
          <span class="rotate-90 lg:rotate-0">Serverless<br />VPC connector</span>
        </div>

        <div class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
          <span class="pill bg-lime text-ink">ML machine · Compute Engine</span>
          <div class="mt-6 rounded-xl bg-lime/10 px-4 py-3 font-medium">Text Generation Inference web server</div>
          <div class="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-2 text-sm">
            <span class="rounded-xl bg-white/10 px-3 py-2">SEA-LION-7B-Instruct<br /><span class="text-paper/65">base model</span></span>
            <span class="text-lime">→</span>
            <span class="rounded-xl bg-white/10 px-3 py-2">TeachTech AI model<br /><span class="text-paper/65">served</span></span>
          </div>
          <p class="mt-3 rounded-xl border border-dashed border-white/20 px-3 py-2 text-sm text-paper/65">
            Transfer learning on Kaizen Room's dataset
          </p>
        </div>
      </div>
      <p class="mt-6 text-sm text-paper/65">Google Cloud Platform · VPC across asia-southeast1 and asia-southeast2.</p>
    </div>
  </section>

  <!-- FLOWS -->
  <section class="wrap py-24 sm:py-32">
    <p class="eyebrow">05 · User flows</p>
    <h2 class="h2 mt-4 max-w-3xl" data-reveal>Three paths, mapped before building.</h2>
    <div class="mt-14 grid gap-4 lg:grid-cols-3" data-stagger>
      {
        flows.map((f) => (
          <div class="rounded-3xl bg-card p-6 ring-1 ring-line">
            <p class="font-display text-xl font-extrabold tracking-tight">{f.t}</p>
            <ol class="mt-6 space-y-2">
              {f.steps.map((s, i) => (
                <li class="flex items-center gap-3">
                  <span class="grid size-7 shrink-0 place-items-center rounded-full bg-[#fee4e2] text-xs font-bold text-[#b42318]">{i + 1}</span>
                  <span class="text-sm">{s}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <!-- DEMO -->
  <section class="border-t border-line bg-card py-24 sm:py-32">
    <div class="wrap">
      <p class="eyebrow">06 · Demo</p>
      <h2 class="h2 mt-4 max-w-3xl" data-reveal>See it running.</h2>
      <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal="0.1">
        The final capstone presentation: background, architecture, user flows and a live demo
        of the app on a device (from 4:01).
      </p>
      <div class="mt-12 aspect-video overflow-hidden rounded-3xl bg-ink shadow-2xl" data-reveal>
        <iframe
          class="size-full"
          src="https://www.youtube-nocookie.com/embed/q1dOfIv6vQY?rel=0"
          title="TeachTechAI capstone presentation"
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- TAKEAWAYS -->
  <section class="wrap grid gap-12 py-24 sm:py-32 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p class="eyebrow">07 · Takeaways</p>
      <h2 class="h2 mt-4" data-reveal>Building it changed how I design.</h2>
    </div>
    <ol class="space-y-8" data-stagger>
      <li>
        <p class="font-display text-xl font-extrabold tracking-tight">Empty prompts scare people.</p>
        <p class="mt-2 text-muted">Prompt inspiration cards gave teachers a first message to send. A blank chat box assumes they already know what to ask.</p>
      </li>
      <li>
        <p class="font-display text-xl font-extrabold tracking-tight">Cross-team contracts first.</p>
        <p class="mt-2 text-muted">Agreeing the REST/JSON shapes with the cloud and ML folks early let mobile, API and model work in parallel.</p>
      </li>
    </ol>
  </section>

  <!-- NEXT -->
  <section class="wrap pb-24">
    <a href="/work/satya" class="group flex flex-col items-start justify-between gap-8 rounded-[32px] bg-[linear-gradient(135deg,#c2410c,#c91f3d)] p-8 text-white sm:flex-row sm:items-end sm:p-14" data-reveal>
      <div>
        <p class="eyebrow !text-white/85">Next case study</p>
        <p class="display mt-4 text-[clamp(2.5rem,6vw,5rem)]">SATYA<span class="text-[#1e2a66]">.</span></p>
        <p class="mt-3 max-w-md text-white/85">Monitoring government programmes and reporting corruption. GEMASTIK XVII.</p>
      </div>
      <span class="rounded-full bg-white px-6 py-3.5 font-medium text-[#1e2a66] transition-transform group-hover:translate-x-1">Read it →</span>
    </a>
  </section>
</Base>
